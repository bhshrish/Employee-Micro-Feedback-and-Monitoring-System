# Public API URL for endpoints that have not yet been migrated to Next.js.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# MongoDB URI for Next.js API routes and the readiness endpoint.
MONGODB_URI=mongodb://127.0.0.1:27017/pulse
# Configure auth secrets server-side only; use the same unique values as the API.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ADMIN_SECRET=replace-with-a-third-32-character-secret
# Frontend origin used in password-reset links and required by production config.
FRONTEND_URL=http://localhost:3000
# Required by shared production config; keep aligned with the API's frontend origin allowlist.
CORS_ORIGINS=http://localhost:3000
# Must match the API's reserved platform administrator email.
OPS_ADMIN_EMAIL=admin@gmail.com
# SMTP is used by native Next.js auth for email codes and password-reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=CalmWork
# Optional SMS provider settings for native SMS sign-in codes.
SMS_API_URL=
SMS_API_TOKEN=
# Password-reset token lifetime in minutes.
PASSWORD_RESET_TTL_MINUTES=60