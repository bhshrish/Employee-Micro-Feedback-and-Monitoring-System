{
  "name": "calmwork-next",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "api:dev": "npm --prefix backend run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --prefix backend run build",
    "build:web": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint && npm --prefix backend run lint",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "npm --workspace frontend run typecheck",
    "typecheck:api": "npm --prefix backend run typecheck",
    "test": "npm --prefix backend test",
    "seed": "npm --prefix backend run seed",
    "start": "npm --workspace frontend run start",
    "start:api": "npm --prefix backend start"
  },
  "dependencies": {
    "mongodb": "^7.8.0"
  }
}
