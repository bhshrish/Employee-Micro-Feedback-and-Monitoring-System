{
  "name": "pulse-next",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "api:dev": "npm --prefix backend run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --prefix backend run build",
    "build:web": "npm --workspace frontend run build",
    "lint": "npm --prefix backend run lint",
    "test": "npm --prefix backend test",
    "seed": "npm --prefix backend run seed",
    "start": "npm --workspace frontend run start",
    "start:api": "npm --prefix backend start"
  }
}
