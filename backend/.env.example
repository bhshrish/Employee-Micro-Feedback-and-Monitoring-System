NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pulse
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=
OPS_ADMIN_PASSWORD=
MIN_PULSE_GROUP_SIZE=5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
LOG_LEVEL=info

# Seed 1 admin, 2 managers, 10 employees, 3 teams, and anonymous weekly pulse samples.
# Use a development-only password; SEED_PASSWORD must be at least 12 characters
# and include uppercase, lowercase, and number characters.
SEED_EMAIL=
SEED_NAME=
SEED_PASSWORD=
SEED_ORGANIZATION=
SEED_TEAMS=Product,People,Operations
