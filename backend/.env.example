# Runtime mode; set to production on the deployed API.
NODE_ENV=development
# API listen port; choose an unused TCP port if 4000 is occupied.
PORT=4000
# MongoDB Atlas: Atlas > Database > Connect > Drivers, or local MongoDB for development.
MONGODB_URI=mongodb://127.0.0.1:27017/pulse
# Local Compose MongoDB root username; choose a unique local-only value.
MONGO_ROOT_USERNAME=calmwork
# Local Compose MongoDB root password; use a random local-only value.
MONGO_ROOT_PASSWORD=replace-with-a-local-mongodb-password
# Deployed frontend origin; use the frontend Vercel deployment URL.
FRONTEND_URL=http://localhost:3000
# Generate each secret independently with a cryptographically secure random generator (32+ characters).
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
# Generate a third independent secret; never reuse access/refresh secrets.
JWT_ADMIN_SECRET=replace-with-a-third-32-character-secret
# Access-token lifetime; use a short duration such as 15m.
ACCESS_TOKEN_TTL=15m
# Refresh cookie lifetime in days (maximum 7).
REFRESH_TOKEN_DAYS=7
# Set true in production when serving over HTTPS.
COOKIE_SECURE=false
# Optional cookie domain; leave empty for host-only cookies.
COOKIE_DOMAIN=
# Comma-separated frontend origins; configure in Vercel project settings.
CORS_ORIGINS=http://localhost:3000
# Administrator OTP destination; use a monitored address configured for the platform administrator.
OPS_ADMIN_EMAIL=admin@gmail.com
# Minimum pulse group size; default privacy threshold is five responses.
MIN_PULSE_GROUP_SIZE=5
# Password-reset token lifetime in minutes (legacy accounts only).
PASSWORD_RESET_TTL_MINUTES=60
# SMTP server hostname; get the host from your email provider.
SMTP_HOST=
# SMTP server port; get the port from your email provider.
SMTP_PORT=587
# SMTP account username; create an SMTP credential in your email provider.
SMTP_USER=
# SMTP account password/app password; create it in your email provider.
SMTP_PASS=
# Verified sender address; configure/verify it with your email provider.
SMTP_FROM=noreply@example.com
# Sender display name shown in emails.
SMTP_FROM_NAME=CalmWork
# Razorpay API key ID; Razorpay Dashboard > Account & Settings > API Keys.
RAZORPAY_KEY_ID=
# Razorpay API key secret; Razorpay Dashboard > Account & Settings > API Keys.
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret; configure a webhook under Razorpay Dashboard > Account & Settings > Webhooks.
RAZORPAY_WEBHOOK_SECRET=
# Monthly Starter plan ID; create a recurring plan in Razorpay Dashboard > Subscriptions > Plans.
RAZORPAY_PLAN_STARTER_MONTHLY=
# Yearly Starter plan ID; create a recurring plan in Razorpay Dashboard > Subscriptions > Plans.
RAZORPAY_PLAN_STARTER_YEARLY=
# Monthly Team plan ID; create a recurring plan in Razorpay Dashboard > Subscriptions > Plans.
RAZORPAY_PLAN_TEAM_MONTHLY=
# Yearly Team plan ID; create a recurring plan in Razorpay Dashboard > Subscriptions > Plans.
RAZORPAY_PLAN_TEAM_YEARLY=
# Monthly Business plan ID; create a recurring plan in Razorpay Dashboard > Subscriptions > Plans.
RAZORPAY_PLAN_BUSINESS_MONTHLY=
# Yearly Business plan ID; create a recurring plan in Razorpay Dashboard > Subscriptions > Plans.
RAZORPAY_PLAN_BUSINESS_YEARLY=
# Optional SMS adapter endpoint; obtain the API URL from your SMS provider.
SMS_API_URL=
# Optional SMS adapter bearer token; create it in your SMS provider dashboard.
SMS_API_TOKEN=
# Log verbosity; use info in production unless diagnosing an issue.
LOG_LEVEL=info

# Optional seed command inputs; set these only when running npm run seed.
# Owner email address for the seeded business.
SEED_EMAIL=
# Owner display name for the seeded business.
SEED_NAME=
# Seed owner password; use a unique value of at least 12 characters.
SEED_PASSWORD=
# Business display name for the seeded organization.
SEED_ORGANIZATION=
# Comma-separated team names created by the seed command.
SEED_TEAMS=General
